{
  "name": "personal-marketplace",
  "version": "0.3.0",
  "description": "Personal multi-provider AI plugin marketplace supporting GPT/Codex, Claude (Code & Cowork), Antigravity, Cursor, Kimi Code, and OpenCode.",
  "author": {
    "name": "Angel Ramirez",
    "email": "angelgabriel.16ra@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./.opencode/plugins/marketplace.js",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Angel-SSJ/personal-marketplace.git"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "biome format --write . && taplo fmt",
    "format:check": "biome format . && taplo fmt --check",
    "lint:biome": "biome check .",
    "lint:toml": "taplo check",
    "lint:html": "node scripts/lint-html.ts",
    "lint": "pnpm run lint:biome && pnpm run lint:toml && pnpm run lint:html",
    "validate:data": "node scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.{ts,js}\"",
    "version:check": "node scripts/bump-version.ts --check",
    "version:audit": "node scripts/bump-version.ts --audit",
    "version:bump": "node scripts/bump-version.ts",
    "plugin:new": "node scripts/new-plugin.ts",
    "check": "pnpm run lint && pnpm run validate:data && pnpm run typecheck && pnpm run test && pnpm run version:check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.12.1",
    "gray-matter": "^4.0.3",
    "html-validate": "^11.21.1",
    "lefthook": "^2.2.2",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}

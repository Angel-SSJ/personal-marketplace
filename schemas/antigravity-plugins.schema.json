{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "antigravity-plugins.schema.json",
  "title": "Antigravity Plugins Configuration (.agents/plugins.json)",
  "type": "object",
  "properties": {
    "inherits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "include_only": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "include_only": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
